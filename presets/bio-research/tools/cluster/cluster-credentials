#!/usr/bin/env bash
# 集群凭据的查看 / 设置 / 清除。
# 两个文件都只存在本机，权限强制 0600。
set -euo pipefail
DSH_HOME="${DSH_HOME:-$HOME/.dsh}"
CONN="$DSH_HOME/dsh-ssh-connections.json"
TOTP="$DSH_HOME/dsh-ssh-totp.json"
die() { printf '✘ %s\n' "$*" >&2; exit 1; }

# 找解释器：预设自管 venv -> DSH 自带运行时 -> PATH 上的 python3。
# 注意不要用 `ls <glob>`——glob 不匹配时 ls 非零，配合 `set -o pipefail` 会直接把脚本干掉。
PY=''
for cand in "$DSH_HOME/bio-research/venv/bin/python3" "$DSH_HOME"/dsh-runtimes/*/dependencies/python/bin/python3; do
  [ -x "$cand" ] && { PY="$cand"; break; }
done
if [ -z "$PY" ]; then
  for cand in /opt/homebrew/bin/python3 /usr/local/bin/python3 /usr/bin/python3; do
    [ -x "$cand" ] && { PY="$cand"; break; }
  done
fi
[ -n "$PY" ] || die '找不到可用的 python3'

cmd_check() {
  printf 'DSH_HOME : %s\n\n' "$DSH_HOME"
  if [ -f "$CONN" ]; then
    printf '✔ %s (%s)\n' "dsh-ssh-connections.json" "$(stat -f%Lp "$CONN")"
    "$PY" - "$CONN" <<'PYEOF'
import json,sys
j=json.load(open(sys.argv[1],encoding="utf-8"))
cs=j.get("connections") or []
if not cs: print("    (connections 为空)")
for c in cs:
    print("    id=%-8s %s@%s:%s  密码 %s" % (
        c.get("id","(无)"), c.get("username","?"), c.get("host","?"),
        c.get("port",22), "已设(%d 字符)" % len(str(c.get("password",""))) if c.get("password") else "**未设**"))
PYEOF
  else
    printf '✘ dsh-ssh-connections.json 不存在\n'
  fi
  printf '\n'
  if [ -f "$TOTP" ]; then
    printf '✔ %s (%s)\n' "dsh-ssh-totp.json" "$(stat -f%Lp "$TOTP")"
    "$PY" - "$TOTP" <<'PYEOF'
import json,sys
j=json.load(open(sys.argv[1],encoding="utf-8"))
if not j: print("    (空)")
for k,v in j.items():
    s=str(v)
    print("    %-28s 密钥 %d 字符  %s" % (k, len(s), "*"*min(len(s),10)))
PYEOF
  else
    printf '✘ dsh-ssh-totp.json 不存在\n'
  fi
}

cmd_set() {
  [ -f "$CONN" ] && { printf '! %s 已存在，先备份为 .bak\n' "$CONN"; cp "$CONN" "$CONN.bak"; }
  printf '集群登录信息（回车用括号里的默认值）\n'
  read -r -p '  主机   : ' HOST;  [ -n "$HOST" ] || die '主机不能为空'
  read -r -p '  端口 (22): ' PORT; PORT="${PORT:-22}"
  read -r -p '  用户名 : ' USER;  [ -n "$USER" ] || die '用户名不能为空'
  read -r -s -p '  密码   : ' PASS;  echo
  read -r -p '  连接 id (hzau): ' ID; ID="${ID:-hzau}"
  read -r -p '  TOTP 的 base32 密钥 : ' SECRET
  [ -n "$SECRET" ] || die '动态口令密钥不能为空（是 base32 种子，不是 6 位数字）'
  SECRET="$(printf '%s' "$SECRET" | tr -d ' ' | tr 'a-z' 'A-Z')"
  case "$SECRET" in *[!A-Z2-7]*) die '密钥只能含 A-Z 与 2-7（base32）';; esac

  "$PY" - "$CONN" "$TOTP" "$ID" "$HOST" "$PORT" "$USER" "$PASS" "$SECRET" <<'PYEOF'
import json,sys,os
conn,totp,cid,host,port,user,pw,secret = sys.argv[1:9]
os.makedirs(os.path.dirname(conn),exist_ok=True)
with open(conn,"w",encoding="utf-8") as f:
    json.dump({"connections":[{"id":cid,"host":host,"port":int(port),
                               "username":user,"password":pw}]}, f, ensure_ascii=False, indent=2)
    f.write("\n")
os.chmod(conn,0o600)
with open(totp,"w",encoding="utf-8") as f:
    json.dump({f"{user}@{host}:{int(port)}": secret}, f, ensure_ascii=False, indent=2)
    f.write("\n")
os.chmod(totp,0o600)
print(f"✔ 已写入 {conn}")
print(f"✔ 已写入 {totp}")
PYEOF
  printf '\n下一步：重启 DSH，然后在会话里调 cluster_status，再用 cluster_exec 跑一条 `hostname` 验证。\n'
}

cmd_show() {
  printf '! 下面会把明文密码与动态口令密钥打印到屏幕上，注意别把输出贴到任何地方。\n'
  read -r -p '  确认？(yes/no) ' ok; [ "$ok" = yes ] || { echo '已取消'; exit 0; }
  [ -f "$CONN" ] && cat "$CONN"
  [ -f "$TOTP" ] && cat "$TOTP"
}

cmd_clear() {
  read -r -p '  删除两个凭据文件？(yes/no) ' ok; [ "$ok" = yes ] || { echo '已取消'; exit 0; }
  rm -f "$CONN" "$TOTP"; echo '✔ 已删除'
}

case "${1:-check}" in
  check) cmd_check ;;
  set)   cmd_set ;;
  show)  cmd_show ;;
  clear) cmd_clear ;;
  *) cat <<EOF
用法: cluster-credentials [check|set|show|clear]
  check  脱敏查看当前配置（默认）
  set    交互式写入两个配置文件（权限 0600）
  show   明文显示（会打印密码与密钥）
  clear  删除两个配置文件
EOF
  ;;
esac
